{
  "name": "tx402-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Development workspace for tx402 — resilient x402 buyer SDK. Not published.",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm --filter \"!tx402-docs\" -r build",
    "check": "pnpm toolchain:check && pnpm build && pnpm lint && pnpm format:check && pnpm typecheck && pnpm nul-check && pnpm workflow-lint && pnpm version:check && pnpm install-contract && pnpm conformance:check && pnpm conformance:selftest && pnpm manifest:verify && pnpm test && pnpm size && pnpm fuzz && pnpm docs:check && pnpm docs:live:selftest && pnpm supply-chain:selftest && pnpm toolchain:selftest && pnpm docs:build",
    "conformance:build": "node tools/conformance/index.js build",
    "conformance:check": "node tools/conformance/index.js check",
    "conformance:selftest": "node tools/conformance/index.js selftest",
    "docs:build": "pnpm --filter tx402-docs build",
    "docs:check": "node tools/docs-gen/index.js check",
    "docs:dev": "pnpm --filter tx402-docs dev",
    "docs:generate": "pnpm --filter tx402 build && node tools/docs-gen/index.js build",
    "docs:live": "node tools/docs-live/index.js check",
    "docs:live:selftest": "node tools/docs-live/index.js selftest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fuzz": "node tools/fuzz/index.js",
    "install-contract": "node tools/install-contract/index.js check",
    "install-smoke": "node tools/install-contract/index.js smoke",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "manifest:verify": "node tools/manifest-signer/index.js verify",
    "nul-check": "node tools/nul-check/index.js",
    "perf": "node --expose-gc tools/perf/index.js",
    "reproducible": "node tools/supply-chain/index.js reproducible",
    "sbom": "node tools/supply-chain/index.js sbom",
    "size": "node tools/size-gate/index.js",
    "supply-chain": "node tools/supply-chain/index.js audit",
    "supply-chain:selftest": "node tools/supply-chain/index.js selftest",
    "test": "pnpm -r test",
    "toolchain:check": "node tools/toolchain-check/index.js check",
    "toolchain:selftest": "node tools/toolchain-check/index.js selftest",
    "typecheck": "pnpm --filter \"!tx402-docs\" -r typecheck",
    "version:check": "node tools/version-sync/index.js check",
    "version:sync": "node tools/version-sync/index.js build",
    "workflow-lint": "node tools/workflow-lint/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^20.17.0",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.5"
  }
}
