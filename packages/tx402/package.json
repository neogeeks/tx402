{
  "name": "tx402",
  "version": "0.1.0",
  "description": "Resilient x402 buyer SDK \u2014 deterministic multi-chain payment routing, local spend guardrails, and a drop-in fetch wrapper for autonomous agents.",
  "license": "Apache-2.0",
  "homepage": "https://tx402.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neogeeks/tx402.git"
  },
  "bugs": {
    "url": "https://github.com/neogeeks/tx402/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "tx402": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./evm": {
      "types": "./dist/evm/index.d.ts",
      "default": "./dist/evm/index.js"
    },
    "./solana": {
      "types": "./dist/solana/index.d.ts",
      "default": "./dist/solana/index.js"
    },
    "./signers": {
      "types": "./dist/signers/index.d.ts",
      "default": "./dist/signers/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "x402",
    "http-402",
    "payments",
    "usdc",
    "stablecoin",
    "ai-agents",
    "base",
    "solana",
    "fetch",
    "sdk"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@x402/core": "~2.20.0"
  },
  "peerDependencies": {
    "@solana-program/token": "^0.9.0",
    "@solana/kit": ">=5.1.0",
    "@x402/evm": "~2.20.0",
    "@x402/svm": "~2.20.0",
    "viem": "^2.48.11"
  },
  "peerDependenciesMeta": {
    "@solana-program/token": {
      "optional": true
    },
    "@x402/evm": {
      "optional": true
    },
    "@x402/svm": {
      "optional": true
    },
    "@solana/kit": {
      "optional": true
    },
    "viem": {
      "optional": true
    }
  },
  "devDependencies": {
    "@solana-program/token": "^0.9.0",
    "@solana/kit": "^5.1.0",
    "@tx402-dev/evm-rpc-stub": "workspace:*",
    "@tx402-dev/svm-rpc-stub": "workspace:*",
    "@tx402-dev/test-merchant": "workspace:*",
    "@vitest/coverage-v8": "^2.1.9",
    "@x402/evm": "~2.20.0",
    "@x402/svm": "~2.20.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "viem": "^2.48.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
