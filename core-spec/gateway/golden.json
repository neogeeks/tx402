  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://tx402.io/schemas/gateway/v1.json",
    "title": "tx402 capability gateway wire protocol",
    "version": 1,
    "$defs": {
      "atomicAmount": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)$",
        "maxLength": 78
      },
      "atomicAccumulator": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)$"
      },
      "reservationState": {
        "enum": [
          "reserved",
          "committed",
          "released",
          "expired",
          "exposed"
        ]
      },
      "reservationRef": {
        "type": "object",
        "properties": {
          "reservationId": {
            "type": "string",
            "minLength": 1
          },
          "policyScope": {
            "type": "string",
            "minLength": 1
          },
          "assetId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "reservationId",
          "policyScope",
          "assetId"
        ],
        "additionalProperties": false
      },
      "reservation": {
        "type": "object",
        "properties": {
          "reservationId": {
            "type": "string",
            "minLength": 1
          },
          "policyScope": {
            "type": "string",
            "minLength": 1
          },
          "requestFingerprint": {
            "type": "string"
          },
          "assetId": {
            "type": "string",
            "minLength": 1
          },
          "amountAtomic": {
            "$ref": "#/$defs/atomicAmount"
          },
          "createdAtEpochMs": {
            "type": "integer",
            "minimum": 0
          },
          "expiresAtEpochMs": {
            "type": "integer",
            "minimum": 0
          },
          "state": {
            "$ref": "#/$defs/reservationState"
          }
        },
        "required": [
          "reservationId",
          "policyScope",
          "requestFingerprint",
          "assetId",
          "amountAtomic",
          "createdAtEpochMs",
          "expiresAtEpochMs",
          "state"
        ],
        "additionalProperties": false
      },
      "entry": {
        "type": "object",
        "properties": {
          "reservationId": {
            "type": "string",
            "minLength": 1
          },
          "requestFingerprint": {
            "type": "string"
          },
          "assetId": {
            "type": "string",
            "minLength": 1
          },
          "amountAtomic": {
            "$ref": "#/$defs/atomicAmount"
          },
          "committedAtEpochMs": {
            "type": "integer",
            "minimum": 0
          },
          "settlementId": {
            "type": "string"
          }
        },
        "required": [
          "reservationId",
          "requestFingerprint",
          "assetId",
          "amountAtomic",
          "committedAtEpochMs"
        ],
        "additionalProperties": false
      },
      "budgetLimits": {
        "type": "object",
        "properties": {
          "maxPerHourAtomic": {
            "$ref": "#/$defs/atomicAmount"
          },
          "maxTotalAtomic": {
            "$ref": "#/$defs/atomicAmount"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "budgetState": {
        "type": "object",
        "properties": {
          "storeKind": {
            "type": "string"
          },
          "policyScope": {
            "type": "string"
          },
          "assetId": {
            "type": "string"
          },
          "committedAtomic": {
            "$ref": "#/$defs/atomicAmount"
          },
          "reservedAtomic": {
            "$ref": "#/$defs/atomicAmount"
          },
          "exposedAtomic": {
            "$ref": "#/$defs/atomicAccumulator"
          },
          "cumulativeCommittedAtomic": {
            "$ref": "#/$defs/atomicAccumulator"
          },
          "cumulativeConsumedAtomic": {
            "$ref": "#/$defs/atomicAccumulator"
          },
          "perHourLimitAtomic": {
            "$ref": "#/$defs/atomicAmount"
