{
  "$schema": "https://tx402.dev/schemas/v1/conformance-vector.schema.json",
  "id": "recipient-pin.behavior.concurrent-claim",
  "kind": "recipient-pin.behavior",
  "milestone": "M6",
  "title": "Concurrent TOFU claims for one recipient converge to a single pin — exactly one reserve establishes it",
  "spec": ["SPEC §6", "SPEC §6.2", "SPEC §3.4", "ADR-028"],
  "description": "The TOFU claim is claim-if-absent inside the reservation atom, so several workers paying the same recipient converge to one pin rather than racing to write several. Modelled as three sequential reserves on one store (the atomicity a durable store's true-parallel harness asserts under real concurrency): the first reports recipientPinEstablished:true and the next two report false — each observes the pin the first claimed. The pin readback holds exactly one recipient, so exactly one worker would have emitted recipient.pinned (the round-6/7 TOFU-race guard, replay-safe).",
