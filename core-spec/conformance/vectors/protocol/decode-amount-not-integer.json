  "id": "protocol.decode-payment-required.amount-not-integer",
  "kind": "protocol.decode-payment-required",
  "milestone": "M1",
  "title": "A decimal amount on the wire is rejected rather than rounded",
  "description": "Upstream `amount` is already atomic units. A value like `\"0.05\"` is either a broken merchant or an attempt to exploit a lenient parser; either way, coercing it risks signing an amount the policy engine never evaluated (ADR-006).",
  "spec": ["SPEC §5.1", "ADR-006"],
  "input": {
    "requestUrl": "https://api.example.com/v1/completions",
    "requestMethod": "POST",
    "header": "",
    "clockEpochMs": 1785711360000
  },
  "expected": {
    "outcome": "invalid",
    "errorCode": "TX402_PAYMENT_REQUIRED_INVALID",
    "reason": "amount-not-atomic-integer"
  }
}
