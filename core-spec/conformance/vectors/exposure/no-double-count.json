  "id": "spend-ledger.behavior.exposure-no-double-count",
  "kind": "spend-ledger.behavior",
  "milestone": "M6",
  "title": "An exposed payment is counted exactly once — commit moves it between terms, and exposed occupies the per-hour cap alongside committed",
